# ── Client Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in the values

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API URL
# In development: leave empty so Vite proxy routes /api/* to localhost:4000
# In production: set to your full Render server URL (no trailing slash)
VITE_API_URL=https://solaris-letters-server.onrender.com
