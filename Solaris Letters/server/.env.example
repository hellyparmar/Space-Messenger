# ── Server Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in the values

PORT=4000
NODE_ENV=production

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# PostgreSQL Connection (Project Settings > Database > Connection String)
# Use the Supabase Pooler (Transaction mode) URL for DATABASE_URL
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the Direct connection URL for DIRECT_URL (used by Prisma migrations)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT Secret — use a strong random string (Render can auto-generate this)
JWT_SECRET=replace_with_a_strong_random_secret

# CORS — Comma-separated list of allowed frontend origins
# In production: set to your Netlify URL, e.g. https://your-app.netlify.app
# In development: leave as http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
