{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
